{
  "name": "Notification",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Empresa"
    },
    "title": {
      "type": "string",
      "title": "T\u00edtulo"
    },
    "message": {
      "type": "string",
      "title": "Mensagem"
    },
    "type": {
      "type": "string",
      "title": "Tipo",
      "enum": [
        "stock",
        "financial",
        "quote",
        "opportunity",
        "goal",
        "sale",
        "purchase",
        "attendance"
      ],
      "default": "sale"
    },
    "priority": {
      "type": "string",
      "title": "Prioridade",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "link": {
      "type": "string",
      "title": "Link"
    },
    "read": {
      "type": "boolean",
      "title": "Lida",
      "default": false
    }
  },
  "required": [
    "company_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
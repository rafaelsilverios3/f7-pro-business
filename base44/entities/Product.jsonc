{
  "name": "Product",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Empresa"
    },
    "sku": {
      "type": "string",
      "title": "SKU"
    },
    "name": {
      "type": "string",
      "title": "Nome"
    },
    "category": {
      "type": "string",
      "title": "Categoria"
    },
    "brand": {
      "type": "string",
      "title": "Marca"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "cost_price": {
      "type": "number",
      "title": "Pre\u00e7o de Custo",
      "default": 0
    },
    "sale_price": {
      "type": "number",
      "title": "Pre\u00e7o de Venda",
      "default": 0
    },
    "stock": {
      "type": "number",
      "title": "Estoque",
      "default": 0
    },
    "min_stock": {
      "type": "number",
      "title": "Estoque M\u00ednimo",
      "default": 0
    },
    "unit": {
      "type": "string",
      "title": "Unidade",
      "default": "un"
    },
    "commission": {
      "type": "number",
      "title": "Comiss\u00e3o %",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "title": "Ativo",
      "default": true
    },
    "image": {
      "type": "string",
      "title": "Imagem"
    }
  },
  "required": [
    "company_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
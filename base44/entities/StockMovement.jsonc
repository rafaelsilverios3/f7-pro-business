{
  "name": "StockMovement",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Empresa"
    },
    "product_id": {
      "type": "string",
      "title": "Produto"
    },
    "product_name": {
      "type": "string",
      "title": "Nome do Produto"
    },
    "type": {
      "type": "string",
      "title": "Tipo",
      "enum": [
        "in",
        "out",
        "adjust"
      ],
      "default": "in"
    },
    "quantity": {
      "type": "number",
      "title": "Quantidade",
      "default": 0
    },
    "reason": {
      "type": "string",
      "title": "Motivo"
    },
    "sale_id": {
      "type": "string",
      "title": "Venda Relacionada"
    },
    "purchase_id": {
      "type": "string",
      "title": "Compra Relacionada"
    }
  },
  "required": [
    "company_id",
    "product_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
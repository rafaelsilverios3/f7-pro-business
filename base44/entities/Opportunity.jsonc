{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Empresa"
    },
    "title": {
      "type": "string",
      "title": "T\u00edtulo"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "source": {
      "type": "string",
      "title": "Origem",
      "enum": [
        "crm",
        "atendimento",
        "intelligence"
      ],
      "default": "crm"
    },
    "customer_id": {
      "type": "string",
      "title": "Cliente"
    },
    "customer_name": {
      "type": "string",
      "title": "Nome do Cliente"
    },
    "value": {
      "type": "number",
      "title": "Valor",
      "default": 0
    },
    "stage": {
      "type": "string",
      "title": "Etapa",
      "enum": [
        "new",
        "qualified",
        "proposal",
        "negotiation",
        "won",
        "lost"
      ],
      "default": "new"
    },
    "assignee": {
      "type": "string",
      "title": "Respons\u00e1vel"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Prazo"
    },
    "insight_id": {
      "type": "string",
      "title": "Insight de Origem"
    },
    "conversation_id": {
      "type": "string",
      "title": "Conversa de Origem"
    }
  },
  "required": [
    "company_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
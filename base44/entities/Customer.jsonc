{
  "name": "Customer",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Empresa"
    },
    "type": {
      "type": "string",
      "title": "Tipo",
      "enum": [
        "pf",
        "pj"
      ],
      "default": "pf"
    },
    "name": {
      "type": "string",
      "title": "Nome"
    },
    "document": {
      "type": "string",
      "title": "Documento"
    },
    "phone": {
      "type": "string",
      "title": "Telefone"
    },
    "whatsapp": {
      "type": "string",
      "title": "WhatsApp"
    },
    "email": {
      "type": "string",
      "title": "E-mail"
    },
    "address": {
      "type": "string",
      "title": "Endere\u00e7o"
    },
    "lead_source": {
      "type": "string",
      "title": "Origem do Lead"
    },
    "owner": {
      "type": "string",
      "title": "Respons\u00e1vel"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tags"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "lead",
        "active",
        "inactive"
      ],
      "default": "lead"
    },
    "classification": {
      "type": "string",
      "title": "Classifica\u00e7\u00e3o",
      "enum": [
        "a",
        "b",
        "c"
      ],
      "default": "b"
    },
    "total_purchased": {
      "type": "number",
      "title": "Total Comprado",
      "default": 0
    },
    "sale_count": {
      "type": "number",
      "title": "N\u00ba Compras",
      "default": 0
    },
    "avg_ticket": {
      "type": "number",
      "title": "Ticket M\u00e9dio",
      "default": 0
    },
    "last_purchase_date": {
      "type": "string",
      "format": "date",
      "title": "\u00daltima Compra"
    }
  },
  "required": [
    "company_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
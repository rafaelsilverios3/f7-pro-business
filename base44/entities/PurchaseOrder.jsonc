{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Empresa"
    },
    "supplier_id": {
      "type": "string",
      "title": "Fornecedor"
    },
    "supplier_name": {
      "type": "string",
      "title": "Nome do Fornecedor"
    },
    "items": {
      "type": "array",
      "title": "Itens",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "cost": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "total": {
      "type": "number",
      "title": "Total",
      "default": 0
    },
    "expected_date": {
      "type": "string",
      "format": "date",
      "title": "Previs\u00e3o de Entrega"
    },
    "received_date": {
      "type": "string",
      "format": "date",
      "title": "Recebimento"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "partial",
        "received",
        "cancelled"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    },
    "financial_entry_id": {
      "type": "string",
      "title": "Conta a Pagar"
    }
  },
  "required": [
    "company_id",
    "supplier_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
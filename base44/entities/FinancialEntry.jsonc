{
  "name": "FinancialEntry",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Empresa"
    },
    "type": {
      "type": "string",
      "title": "Tipo",
      "enum": [
        "receivable",
        "payable"
      ],
      "default": "receivable"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "category": {
      "type": "string",
      "title": "Categoria"
    },
    "amount": {
      "type": "number",
      "title": "Valor",
      "default": 0
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Vencimento"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "title": "Pagamento"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "paid",
        "overdue",
        "cancelled"
      ],
      "default": "pending"
    },
    "sale_id": {
      "type": "string",
      "title": "Venda"
    },
    "purchase_id": {
      "type": "string",
      "title": "Compra"
    },
    "payment_method": {
      "type": "string",
      "title": "Forma de Pagamento"
    },
    "account": {
      "type": "string",
      "title": "Conta"
    },
    "recurring": {
      "type": "boolean",
      "title": "Recorrente",
      "default": false
    }
  },
  "required": [
    "company_id",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "AutomationLog",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Empresa"
    },
    "automation_id": {
      "type": "string",
      "title": "Automa\u00e7\u00e3o"
    },
    "automation_name": {
      "type": "string",
      "title": "Nome da Automa\u00e7\u00e3o"
    },
    "trigger": {
      "type": "string",
      "title": "Gatilho"
    },
    "event_data": {
      "type": "string",
      "title": "Dados do Evento"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "success",
        "error",
        "skipped"
      ],
      "default": "success"
    },
    "error_message": {
      "type": "string",
      "title": "Erro"
    }
  },
  "required": [
    "company_id",
    "automation_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
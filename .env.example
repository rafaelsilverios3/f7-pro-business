# Identificador público da aplicação no Base44
VITE_BASE44_APP_ID=

# URL base opcional para proxy/API do Base44
VITE_BASE44_APP_BASE_URL=

# Provider de dados: base44 (padrão) ou supabase
VITE_DATA_PROVIDER=base44

# Somente chave pública anon do Supabase; nunca use service_role no frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Tokens de sessão são gerenciados pelo fluxo de autenticação e pelo armazenamento seguro
# do navegador/servidor. Nunca crie uma variável VITE_* para guardar segredo.

# Public institutional site (optional)
VITE_PUBLIC_APP_URL=/login
VITE_PUBLIC_CONTACT_EMAIL=

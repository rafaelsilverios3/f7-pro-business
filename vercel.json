{
  "redirects": [
    { "source": "/f7food", "destination": "/f7-food", "permanent": true },
    { "source": "/f7food/:path*", "destination": "/f7-food/:path*", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/f7-food/assets/:path*",
      "destination": "https://f7-food.vercel.app/assets/:path*"
    },
    {
      "source": "/f7-food/",
      "destination": "https://f7-food.vercel.app/f7-food"
    },
    {
      "source": "/f7-food",
      "destination": "https://f7-food.vercel.app/f7-food"
    },
    {
      "source": "/f7-food/:path*",
      "destination": "https://f7-food.vercel.app/f7-food/:path*"
    },
    {
      "source": "/entrecafeerecomecos/api/:path*",
      "destination": "https://f7-entre-cafe-recomecos.vercel.app/api/:path*"
    },
    {
      "source": "/entrecafeerecomecos/assets/:path*",
      "destination": "https://f7-entre-cafe-recomecos.vercel.app/assets/:path*"
    },
    {
      "source": "/entrecafeerecomecos/",
      "destination": "https://f7-entre-cafe-recomecos.vercel.app/entrecafeerecomecos"
    },
    {
      "source": "/entrecafeerecomecos",
      "destination": "https://f7-entre-cafe-recomecos.vercel.app/entrecafeerecomecos"
    },
    {
      "source": "/entrecafeerecomecos/:path*",
      "destination": "https://f7-entre-cafe-recomecos.vercel.app/entrecafeerecomecos/:path*"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
